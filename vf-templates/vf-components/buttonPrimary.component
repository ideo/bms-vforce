<apex:component >

  <!-- ===== Attributes ===== -->
  <apex:attribute name="buttonText" 
    type="String" 
    description="Text displayed on the button" 
    required="true"
  />

  <apex:attribute name="buttonLink" 
    type="String" 
    description="URL the button links to" 
    required="true"
  />

  <apex:attribute name="productType" 
    type="String" 
    description="Controls theme: 'commercial', 'clinical', or 'security'" 
    required="true"
  />

  <!-- ===== Theme Logic ===== -->
  <!-- Default: commercial -->
  <apex:variable var="bgColor" value="var(--coomassie-blue, #144A8E)"/>
  <apex:variable var="textColor" value="var(--white, #FFFFFF)"/>

  <!-- Clinical override -->
  <apex:outputPanel rendered="{!productType = 'clinical'}">
    <apex:variable var="bgColor" value="var(--olive-grove, #4D7828)"/>
    <apex:variable var="textColor" value="var(--white, #FFFFFF)"/>
  </apex:outputPanel>

  <!-- Security override -->
  <apex:outputPanel rendered="{!productType = 'security'}">
    <apex:variable var="bgColor" value="var(--golden-yellow, #FFC72A)"/>
    <apex:variable var="textColor" value="var(--midnight-ash, #222222)"/>
  </apex:outputPanel>

  <!-- ===== CTA Button ===== -->
  <table 
    cellpadding="0" 
    cellspacing="0" 
    border="0" 
    style="margin: 0 auto 24px auto;"
  >
    <tr>
      <td align="center" style="padding: 0;">
        <table 
          cellpadding="0" 
          cellspacing="0" 
          border="0" 
          style="display: inline-table;"
        >
          <tr>
            <td 
              align="center" 
              valign="middle"
              style="
                background-color: {!bgColor};
                border-radius: 8px;
                padding: 10px 16px;
              "
            >
              <a 
                href="{!buttonLink}"
                target="_blank"
                rel="noopener noreferrer"
                style="
                  color: {!textColor};
                  font-family: 'Avenir', Arial, sans-serif;
                  font-size: 14px;
                  font-weight: 500;
                  text-decoration: none;
                  display: block;
                  line-height: 19px;
                "
              >
                {!buttonText}
              </a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

</apex:component>