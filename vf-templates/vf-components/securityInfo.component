<apex:component >

  <!-- ===== Attributes ===== -->
  <apex:attribute name="label" type="String" required="false" default="Username"
                  description="Left label text"/>
  <apex:attribute name="value" type="String" required="true"
                  description="Right value text"/>
  <apex:attribute name="gap" type="Integer" required="false" default="24"
                  description="Gap in pixels between label and value"/>
  <apex:attribute name="padX" type="Integer" required="false" default="8"
                  description="Horizontal padding in pixels"/>
  <apex:attribute name="padY" type="Integer" required="false" default="2"
                  description="Vertical padding in pixels"/>
  <apex:attribute name="bgColor" type="String" required="false" default="var(--white, #FFFFFF)"
                  description="Background color (uses CSS variable by default)"/>

  <!-- ===== Markup (table-based; width hugs content) ===== -->
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="text-align:center;">
    <tr>
      <td align="center" style="padding-top:12px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0"
               style="display:inline-table; background-color:{!bgColor}; border-radius:8px;">
          <tr>
            <td style="padding:{!padY}px {!padX}px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="display:inline-table;">
                <tr>
                  <!-- Label -->
                  <td style="
                        color:var(--stone-gray, #7B7B7B);
                        font-family:'Avenir', Arial, sans-serif;
                        font-size:12px; font-weight:500; line-height:16px;
                        white-space:nowrap;">
                    {!label}
                  </td>

                  <!-- Gap -->
                  <td style="width:{!gap}px; font-size:0; line-height:0;">&nbsp;</td>

                  <!-- Value -->
                  <td style="padding:2px 0;">
                    <span style="
                          color:var(--coomassie-blue, #144A8E);
                          font-family:'Avenir', Arial, sans-serif;
                          font-size:12px; font-weight:700; line-height:16px;
                          white-space:nowrap;">
                      {!value}
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

</apex:component>