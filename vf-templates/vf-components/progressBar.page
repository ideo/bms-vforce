<apex:component >

  <!-- Attributes (description is REQUIRED) -->
  <apex:attribute name="desktopSrc"  type="String" required="true"
                  description="URL of the desktop progress bar image"/>
  <apex:attribute name="mobileSrc"   type="String" required="true"
                  description="URL of the mobile progress bar image"/>
  <apex:attribute name="alt"         type="String" required="false" default="Progress bar"
                  description="Alt text for the progress bar images"/>
  <apex:attribute name="productType" type="String" required="true"
                  description="Determines background color: 'commercial' or 'clinical'"/>

  <!-- Logic for background color -->
  <apex:variable var="bgColor" value="var(--cloudy-sky, #D0DBE8)"/>
  <apex:outputPanel rendered="{!productType = 'clinical'}">
    <apex:variable var="bgColor" value="var(--pastel-green, #D2E4C3)"/>
  </apex:outputPanel>

  <!-- Component Markup -->
  <table 
    role="presentation"
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    class="container cap-682 web round-0"
    style="background-color:{!bgColor};"
  >
    <tr>
      <td align="center" class="pad-0">
        <!-- Desktop -->
        <img 
          src="{!desktopSrc}" 
          width="682" 
          alt="{!alt}" 
          class="show-desktop"
          style="display:block; width:682px; height:auto;" 
        />
        <!-- Mobile -->
        <img 
          src="{!mobileSrc}" 
          width="359" 
          alt="{!alt}" 
          class="show-mobile progress-bar-mobile"
          style="display:block; width:344px; height:auto; margin:0 auto;" 
        />
      </td>
    </tr>
  </table>

</apex:component>