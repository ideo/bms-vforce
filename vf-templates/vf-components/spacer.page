<apex:component >
    <apex:attribute name="height" type="Integer" description="Height of the spacer in pixels" default="8"/>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
         <tr>
             <td style="height:{!height}px; line-height:8px; font-size:0;">&nbsp;</td>
         </tr>
    </table>
</apex:component>